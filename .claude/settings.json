{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm.cmd run lint)",
      "Bash(npm.cmd run build)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git branch --show-current)",
      "Bash(gh auth status)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run build)",
      "PowerShell(npm.cmd run lint)",
      "PowerShell(npm.cmd run build)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git fetch *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(gh auth status)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr checks *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm uninstall *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(firebase *)",
      "Bash(npx firebase-tools *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm ci *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git checkout *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(firebase *)",
      "PowerShell(npx firebase-tools *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin grupo-a)",
      "Bash(git push origin grupo-a *)",
      "Bash(git push origin grupo-b)",
      "Bash(git push origin grupo-b *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh pr merge * --admin*)",
      "Bash(firebase deploy --only firestore*)",
      "Bash(firebase deploy --only storage*)",
      "Bash(npx firebase-tools deploy --only firestore*)",
      "Bash(npx firebase-tools deploy --only storage*)",
      "PowerShell(git push origin main)",
      "PowerShell(git push origin main *)",
      "PowerShell(git push origin grupo-a *)",
      "PowerShell(git push origin grupo-b *)",
      "PowerShell(git push --force *)",
      "PowerShell(gh pr merge * --admin*)",
      "PowerShell(npx firebase-tools deploy --only firestore*)",
      "PowerShell(npx firebase-tools deploy --only storage*)"
    ]
  }
}
